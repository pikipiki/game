{
  "name": "royaumes-des-peluches",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.config.single.ts",
    "build:jouer": "pnpm build:single && node scripts/copy-jouer.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "sonar": "bash scripts/sonar-local.sh",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^10.0.0-alpha.0",
    "@mui/material": "^10.0.0-alpha.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0-alpha-2026-10-22",
    "@sonar/scan": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0-beta.1",
    "eslint": "10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "7.1.0-dev.20261022.1",
    "typescript-eslint": "8.72.1-alpha.7",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.4"
  }
}
